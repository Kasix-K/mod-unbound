[worldserver]

###################################################################################################
# mod-unbound
#
#    Unbound.ExpansionUnlocked
#        Description: Which expansions' content is released. Locked expansions' dungeons, raids and
#                     zones (Outland, Northrend) can't be entered; the Blood Elf and Draenei starting
#                     zones stay open. When releasing an expansion, also raise MaxPlayerLevel in
#                     worldserver.conf (70 for The Burning Crusade, 80 for Wrath of the Lich King) and,
#                     for Wrath, allow Death Knights again (CharacterCreating.Disabled.ClassMask).
#        Default:     0 - Classic only
#                     1 - Classic + The Burning Crusade
#                     2 - Classic + The Burning Crusade + Wrath of the Lich King

Unbound.ExpansionUnlocked = 0

#    Unbound.WorldBoss.Announce
#        Description: Server-wide announcements for world bosses (src/unbound_world_bosses.cpp): before one
#                     spawns, when it spawns (with the location), when it dies (with who killed it) and
#                     when it despawns unchallenged.
#        Default:     1 - Enabled
#                     0 - Disabled
#
#    Unbound.WorldBoss.Warnings
#        Description: Minutes before a world boss spawns to announce it, one announcement each.
#        Default:     "10, 5"
#
#    Unbound.WorldBoss.DespawnHours
#        Description: A world boss nobody killed despawns this many hours after it spawned (never during a
#                     fight); its normal respawn timer then starts again. 0 = it stays until killed.
#        Default:     24

Unbound.WorldBoss.Announce = 1
Unbound.WorldBoss.Warnings = "10, 5"
Unbound.WorldBoss.DespawnHours = 24

#    Unbound.Perks.RapidRecovery
#        Description: Rapid Recovery permanent perk: after leaving combat, restore a percentage of
#                     maximum health and mana every second until full.
#        Default:     1 - Enabled
#                     0 - Disabled
#
#    Unbound.Perks.RapidRecovery.Delay
#        Description: Milliseconds out of combat before the recovery starts, one value per rank.
#        Default:     "6000, 5000, 4000"
#
#    Unbound.Perks.RapidRecovery.Percent
#        Description: Percent of maximum health and mana restored each second, one value per rank.
#        Default:     "4, 6, 8"
#
#    Unbound.Perks.RapidRecovery.RankLevels
#        Description: Character level that reaches each rank (a GM can set a rank with
#                     ".perk rank 3 <rank>"; ".perk rank 3" goes back to the level's rank).
#        Default:     "1, 30, 60"

Unbound.Perks.RapidRecovery = 1
Unbound.Perks.RapidRecovery.Delay = "6000, 5000, 4000"
Unbound.Perks.RapidRecovery.Percent = "4, 6, 8"
Unbound.Perks.RapidRecovery.RankLevels = "1, 30, 60"

#    Offensive perks (src/unbound_perks.cpp). Five ranks each: Ranks 1-3 by level (1, 30, 60; Rank 3 is the
#    value from before ranks existed), Ranks 4-5 for the endgame. Level 255 can't be reached, so Ranks 4-5
#    are only for GM testing (.perk rank <id> <rank>) until a way to earn them exists; lower a 255 to open
#    a rank, or give a perk fewer values for fewer ranks. Only the upside is ranked: drawbacks and caps stay.
#
#    Unbound.Perks.CyclicPower.High                     (perk 101) the high point of the damage wave (%, the low stays -10%)
#    Unbound.Perks.CriticalUnderstanding.Max            (perk 102) maximum crit damage bonus (%)
#    Unbound.Perks.DefensiveSacrifice.StatPercent       (perk 103) % of attack power and spell power gained
#    Unbound.Perks.DesperatePower.Damage                (perk 104) damage dealt +%
#    Unbound.Perks.BlockCapping.Max                     (perk 105) maximum damage bonus (%)
#    Unbound.Perks.DodgeCapping.Max                     (perk 106) maximum damage bonus (%)
#    Unbound.Perks.ParryCapping.Max                     (perk 107) maximum damage bonus (%)
#    Unbound.Perks.HasteCapping.Max                     (perk 108) maximum damage bonus (%)
#    Unbound.Perks.PetEncouragement.Percent             (perk 109) pet damage +%
#    Unbound.Perks.RollingMomentum.Max                  (perk 110) maximum damage bonus (%)
#    Unbound.Perks.TunnelVision.Bonus                   (perk 111) single-target damage +% (area -10% stays)
#    Unbound.Perks.CollateralDamage.Bonus               (perk 112) area damage +% (single-target -10% stays)
#    Unbound.Perks.GiantSlayer.Percent                  (perk 113) damage to bosses +%
#    Unbound.Perks.Merciless.Percent                    (perk 114) damage-over-time +%
#    Unbound.Perks.Pressure.Stacks                      (perk 115) maximum stacks (+1% each)
#    Unbound.Perks.Chaos.Chance                         (perk 116) chance (%) for +50% damage
#    Unbound.Perks.PowerConversion.Max                  (perk 117) maximum damage bonus (%)
#    Unbound.Perks.HealingPowah.Percent                 (perk 118) healing done +%
#    Unbound.Perks.ShadowMastery.Percent                (perk 119) Shadow damage +%
#    Unbound.Perks.HolyMastery.Percent                  (perk 120) Holy damage +%
#    Unbound.Perks.ArcaneMastery.Percent                (perk 121) Arcane damage +%
#    Unbound.Perks.NatureMastery.Percent                (perk 122) Nature damage +%
#    Unbound.Perks.FireMastery.Percent                  (perk 123) Fire damage +%
#    Unbound.Perks.FrostMastery.Percent                 (perk 124) Frost damage +%
#    Unbound.Perks.PhysicalMastery.Percent              (perk 125) Physical damage +%

Unbound.Perks.CyclicPower.High = "10, 15, 20, 25, 30"
Unbound.Perks.CyclicPower.RankLevels = "1, 30, 60, 255, 255"
Unbound.Perks.CriticalUnderstanding.Max = "8, 14, 20, 26, 30"
Unbound.Perks.CriticalUnderstanding.RankLevels = "1, 30, 60, 255, 255"
