Unbound.Perks.Vampirism.RankLevels = "1, 30, 60, 255, 255"
Unbound.Perks.SoulDrain.Percent = "6, 8, 10, 13, 15"
Unbound.Perks.SoulDrain.HealingTaken = "20, 20, 20, 20, 20"
Unbound.Perks.SoulDrain.RankLevels = "1, 30, 60, 255, 255"
Unbound.Perks.PetReplenishment.Percent = "20, 35, 50, 65, 75"
Unbound.Perks.PetReplenishment.RankLevels = "1, 30, 60, 255, 255"
Unbound.Perks.PetsRoar.Percent = "100, 200, 300, 400, 450"
Unbound.Perks.PetsRoar.RankLevels = "1, 30, 60, 255, 255"
