[worldserver]

###################################################################################################
# mod-unbound
#
#    Unbound.ExpansionUnlocked
#        Description: Which expansions' content is released. Locked expansions' dungeons, raids and
#                     zones (Outland, Northrend) can't be entered; the Blood Elf and Draenei starting
#                     zones stay open. When releasing an expansion, also raise MaxPlayerLevel in
#                     worldserver.conf (70 for The Burning Crusade, 80 for Wrath of the Lich King) and,
#                     for Wrath, allow Death Knights again (CharacterCreating.Disabled.ClassMask).
#        Default:     0 - Classic only
#                     1 - Classic + The Burning Crusade
#                     2 - Classic + The Burning Crusade + Wrath of the Lich King

Unbound.ExpansionUnlocked = 0

#    Unbound.Perks.RapidRecovery
#        Description: Rapid Recovery permanent perk: after leaving combat, restore a percentage of
#                     maximum health and mana every second until full.
#        Default:     1 - Enabled
#                     0 - Disabled
#
#    Unbound.Perks.RapidRecovery.Delay
#        Description: Milliseconds out of combat before the recovery starts, one value per rank.
#        Default:     "6000, 5000, 4000"
#
#    Unbound.Perks.RapidRecovery.Percent
#        Description: Percent of maximum health and mana restored each second, one value per rank.
#        Default:     "4, 6, 8"
#
#    Unbound.Perks.RapidRecovery.RankLevels
#        Description: Character level that reaches each rank (a GM can set a rank with
#                     ".perk rank 3 <rank>"; ".perk rank 3" goes back to the level's rank).
#        Default:     "1, 30, 60"

Unbound.Perks.RapidRecovery = 1
Unbound.Perks.RapidRecovery.Delay = "6000, 5000, 4000"
Unbound.Perks.RapidRecovery.Percent = "4, 6, 8"
Unbound.Perks.RapidRecovery.RankLevels = "1, 30, 60"

#    Unbound.Perks.IronWill.Percent
#        Description: Iron Will utility perk: how much shorter enemy crowd control (stun, fear, root,
#                     silence, sleep, polymorph, charm, disorient, sap) lasts on the player and their pets,
#                     in percent, one value per rank.
#        Default:     "10, 20, 30"
#
#    Unbound.Perks.IronWill.RankLevels
#        Description: Character level that reaches each rank (a GM can set a rank with
#                     ".perk rank 303 <rank>"; ".perk rank 303" goes back to the level's rank).
#        Default:     "1, 30, 60"

Unbound.Perks.IronWill.Percent = "10, 20, 30"
Unbound.Perks.IronWill.RankLevels = "1, 30, 60"

#    Utility perks (src/unbound_perks.cpp). Every value list has one number per rank (Rank 1, 2, 3), and
#    each perk's RankLevels is the character level that reaches each rank (default "1, 30, 60"; a GM can
#    set a rank with ".perk rank <perk id> <rank>"). Decimals are allowed. At most 3 Utility perks can be
#    active at once.
#
#    Unbound.Perks.LongerLegs.*            (perk 304)
#        RunSpeed: run speed % (you and your pet); MountSpeed: mounted speed %; SwimSpeed: swim speed %
#        (you and your pet); FallDamage: fall damage reduction %.
#    Unbound.Perks.PlantedFeet.*           (perk 305, "Planting your legs")
#        Health / Mana: % of maximum restored every second after standing still for Delay seconds.
#    Unbound.Perks.RelentlessPursuit.*     (perk 306)
#        Speed: run speed % for you and your pet for Duration seconds after a kill.
#    Unbound.Perks.Vampirism.Percent       (perk 307) heal for this % of damage dealt.
#    Unbound.Perks.SoulDrain.*             (perk 308)
#        Percent: you and your pet heal for this % of your own damage; HealingTaken: direct healing on you
#        and your pet is reduced by this %.
#    Unbound.Perks.PetReplenishment.Percent  (perk 309) pet healing taken +%.
#    Unbound.Perks.PetsRoar.Percent        (perk 310) pet threat +%.
#    Unbound.Perks.SilentKiller.Percent    (perk 311) your threat -%.
#    Unbound.Perks.UnbreakablePresence.Percent (perk 312) your threat +%.
#    Unbound.Perks.SteadyHands.*           (perk 313)
#        Pushback: spell pushback reduction %; Lockout: interrupt lockouts and silences on you shorter by %.
#    Unbound.Perks.ManaLeech.Percent       (perk 314) mana restored as % of damage dealt (mana users only).

Unbound.Perks.LongerLegs.RunSpeed = "4, 7, 10"
Unbound.Perks.LongerLegs.MountSpeed = "4, 7, 10"
Unbound.Perks.LongerLegs.SwimSpeed = "20, 35, 50"
Unbound.Perks.LongerLegs.FallDamage = "20, 35, 50"
Unbound.Perks.LongerLegs.RankLevels = "1, 30, 60"
Unbound.Perks.PlantedFeet.Health = "0.5, 0.75, 1"
Unbound.Perks.PlantedFeet.Mana = "0.25, 0.4, 0.5"
Unbound.Perks.PlantedFeet.Delay = "3, 3, 3"
Unbound.Perks.PlantedFeet.RankLevels = "1, 30, 60"
Unbound.Perks.RelentlessPursuit.Speed = "15, 25, 35"
Unbound.Perks.RelentlessPursuit.Duration = "10, 10, 10"
Unbound.Perks.RelentlessPursuit.RankLevels = "1, 30, 60"
Unbound.Perks.Vampirism.Percent = "3, 4, 5"
Unbound.Perks.Vampirism.RankLevels = "1, 30, 60"
Unbound.Perks.SoulDrain.Percent = "6, 8, 10"
Unbound.Perks.SoulDrain.HealingTaken = "20, 20, 20"
Unbound.Perks.SoulDrain.RankLevels = "1, 30, 60"
Unbound.Perks.PetReplenishment.Percent = "20, 35, 50"
Unbound.Perks.PetReplenishment.RankLevels = "1, 30, 60"
Unbound.Perks.PetsRoar.Percent = "100, 200, 300"
Unbound.Perks.PetsRoar.RankLevels = "1, 30, 60"
Unbound.Perks.SilentKiller.Percent = "20, 35, 50"
Unbound.Perks.SilentKiller.RankLevels = "1, 30, 60"
Unbound.Perks.UnbreakablePresence.Percent = "50, 100, 150"
Unbound.Perks.UnbreakablePresence.RankLevels = "1, 30, 60"
Unbound.Perks.SteadyHands.Pushback = "30, 50, 70"
Unbound.Perks.SteadyHands.Lockout = "10, 20, 30"
Unbound.Perks.SteadyHands.RankLevels = "1, 30, 60"
Unbound.Perks.ManaLeech.Percent = "1, 1.5, 2"
Unbound.Perks.ManaLeech.RankLevels = "1, 30, 60"

#    Defensive perks (src/unbound_perks.cpp). One number per rank (Rank 1, 2, 3), RankLevels as above
#    (default "1, 30, 60"). At most 3 Defensive perks can be active at once.
#
#    Unbound.Perks.GreaterBulwark.Efficiency    (perk 204) Dodge + Parry become Block at this % (needs a shield)
#    Unbound.Perks.EvasiveManeuvers.Efficiency  (perk 205) Block + Parry become Dodge at this %
#    Unbound.Perks.ParryKing.Efficiency         (perk 206) Block + Dodge become Parry at this %
#    Unbound.Perks.ReinforcedArmor.Percent      (perk 207) physical damage taken -%
#    Unbound.Perks.Spellwarded.Percent          (perk 208) magic damage taken -%
#    Unbound.Perks.Stoicism.Percent             (perk 209) damage-over-time damage taken -% (you and your pet)
#    Unbound.Perks.DefensiveMomentum.*          (perk 210) Max: damage reduction % at 10 stacks (one stack
#                                               per second moving); ResetAfter: seconds standing still that
#                                               remove the stacks
#    Unbound.Perks.Fortress.*                   (perk 211) Max: the same per second standing still;
#                                               ResetAfter: seconds moving that remove the stacks

Unbound.Perks.GreaterBulwark.Efficiency = "100, 110, 120"
Unbound.Perks.GreaterBulwark.RankLevels = "1, 30, 60"
Unbound.Perks.EvasiveManeuvers.Efficiency = "100, 110, 120"
Unbound.Perks.EvasiveManeuvers.RankLevels = "1, 30, 60"
Unbound.Perks.ParryKing.Efficiency = "100, 110, 120"
Unbound.Perks.ParryKing.RankLevels = "1, 30, 60"
Unbound.Perks.ReinforcedArmor.Percent = "4, 7, 10"
Unbound.Perks.ReinforcedArmor.RankLevels = "1, 30, 60"
Unbound.Perks.Spellwarded.Percent = "4, 7, 10"
Unbound.Perks.Spellwarded.RankLevels = "1, 30, 60"
Unbound.Perks.Stoicism.Percent = "8, 14, 20"
Unbound.Perks.Stoicism.RankLevels = "1, 30, 60"
Unbound.Perks.DefensiveMomentum.Max = "5, 7.5, 10"
Unbound.Perks.DefensiveMomentum.ResetAfter = "2, 2, 2"
Unbound.Perks.DefensiveMomentum.RankLevels = "1, 30, 60"
Unbound.Perks.Fortress.Max = "5, 7.5, 10"
Unbound.Perks.Fortress.ResetAfter = "3, 3, 3"
Unbound.Perks.Fortress.RankLevels = "1, 30, 60"

#    Unbound.Attunement.Enable
#        Description: Gear attunement: attuned items permanently give the character a percentage of
#                     their fixed stats (src/unbound_attunement.cpp, ROADMAP.md Power budget).
#        Default:     1 - Enabled
#                     0 - Disabled (attunement stats are removed at the next login)
#
#    Unbound.Attunement.Percent
#        Description: Percent of an attuned item's fixed stats the character gets.
#        Default:     20
#
#    Unbound.Attunement.LevelRange
#        Description: Only items whose required level is within this many levels of the level cap count
#                     (with a cap of 60 and 10: required level 50-60).
#        Default:     10
#
#    Unbound.Attunement.ReferenceSetStats
#        Description: Stat points of a full set of gear at the level cap (about 17 blue/epic items of
#                     about 35 stat points each at level 60). The diminishing returns below are percents
#                     of this.
#        Default:     600
#
#    Unbound.Attunement.FullValueUntil
#    Unbound.Attunement.HalfValueUntil
#        Description: Diminishing returns, in percent of the reference set: attunement stats count in full
#                     until they reach FullValueUntil, at half value until HalfValueUntil, at a quarter
#                     beyond.
#        Default:     100, 200

Unbound.Attunement.Enable = 1
Unbound.Attunement.Percent = 20
Unbound.Attunement.LevelRange = 10
Unbound.Attunement.ReferenceSetStats = 600
Unbound.Attunement.FullValueUntil = 100
Unbound.Attunement.HalfValueUntil = 200

#    Unbound.Attunement.Kills
#        Description: Kills an equipped item needs to be attuned, by quality: green, blue, epic, legendary.
#                     Only creatures that would give experience count (not grey, critters, totems or pets).
#        Default:     "50, 100, 200, 400"
#
#    Unbound.Attunement.EliteKills
#    Unbound.Attunement.BossKills
#        Description: How many kills an elite and a boss (dungeon, raid or world boss) count as.
#        Default:     2, 10

Unbound.Attunement.Kills = "50, 100, 200, 400"
Unbound.Attunement.EliteKills = 2
Unbound.Attunement.BossKills = 10

#    Unbound.Attunement.SacrificeGold
#        Description: Gold price to sacrifice an item at the Altar of Sacrifice (190103), by quality:
#                     green, blue, epic, legendary. The item is destroyed and attuned at once.
#        Default:     "2, 10, 50, 250"
#
#    Unbound.Attunement.SacrificeOwnGearMultiplier
#        Description: The price is multiplied by this for gear the player could attune by wearing it
#                     (their armour type, their class's weapons), so attuning stays the main route for
#                     one's own gear.
#        Default:     2

Unbound.Attunement.SacrificeGold = "2, 10, 50, 250"
Unbound.Attunement.SacrificeOwnGearMultiplier = 2