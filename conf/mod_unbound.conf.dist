#    Unbound.Attunement.Enable
#        Description: Gear infusion (called attunement in the code and these setting names): infused items
#                     permanently give the character a percentage of their fixed stats
#                     (src/unbound_attunement.cpp, ROADMAP.md Power budget).
#        Default:     1 - Enabled
#                     0 - Disabled (infusion stats are removed at the next login)
#
#    Unbound.Attunement.Percent
#        Description: Percent of an infused item's fixed stats the character gets.
#        Default:     20
#
#    Unbound.Attunement.LevelRange
#        Description: Only items whose required level is within this many levels of the level cap count
#                     (with a cap of 60 and 10: required level 50-60).
#        Default:     10
#
#    Unbound.Attunement.ReferenceSetStats
#        Description: Stat points of a full set of gear at the level cap (about 17 blue/epic items of
#                     about 35 stat points each at level 60). The diminishing returns below are percents
#                     of this.
#        Default:     600
#
#    Unbound.Attunement.FullValueUntil
#    Unbound.Attunement.HalfValueUntil
#        Description: Diminishing returns, in percent of the reference set: infusion stats count in full
#                     until they reach FullValueUntil, at half value until HalfValueUntil, at a quarter
#                     beyond.
#        Default:     100, 200

Unbound.Attunement.Enable = 1
Unbound.Attunement.Percent = 20
Unbound.Attunement.LevelRange = 10
Unbound.Attunement.ReferenceSetStats = 600
Unbound.Attunement.FullValueUntil = 100
Unbound.Attunement.HalfValueUntil = 200

#    Unbound.Attunement.Kills
#        Description: Kills an equipped item needs to be infused, by quality: green, blue, epic, legendary.
#                     Only creatures that would give experience count (not grey, critters, totems or pets).
#        Default:     "50, 100, 200, 400"
#
#    Unbound.Attunement.EliteKills
#    Unbound.Attunement.BossKills
#        Description: How many kills an elite and a boss (dungeon, raid or world boss) count as.
#        Default:     2, 10

Unbound.Attunement.Kills = "50, 100, 200, 400"
Unbound.Attunement.EliteKills = 2
Unbound.Attunement.BossKills = 10

#    Unbound.Attunement.TributeGold
#        Description: Gold price to offer an item as tribute at the Altar of Tribute (190103), by quality:
#                     green, blue, epic, legendary. The item is destroyed and infused at once.
#                     (Before the rename: Unbound.Attunement.SacrificeGold, still read if this is missing.)
#        Default:     "2, 10, 50, 250"
#
#    Unbound.Attunement.TributeOwnGearMultiplier
#        Description: The price is multiplied by this for gear the player could infuse by wearing it
#                     (their armour type, their class's weapons), so infusing stays the main route for
#                     one's own gear.
#                     (Before the rename: Unbound.Attunement.SacrificeOwnGearMultiplier.)
#        Default:     2

Unbound.Attunement.TributeGold = "2, 10, 50, 250"
Unbound.Attunement.TributeOwnGearMultiplier = 2
#    Unbound.SoloRaid.Enable
#        Description: Soloable raid mechanics (src/unbound_solo_raids.cpp): mechanics no single player
#                     can handle are changed while a raid has at most one player in it (GMs don't
#                     count; pets aren't players, playerbots are). With two or more players every fight
#                     is unchanged. Turns all of the fixes below on or off.
#        Default:     1 - Enabled
#                     0 - Disabled
#
#    Unbound.SoloRaid.Razorgore
#        Description: Blackwing Lair, Razorgore the Untamed: Grethok the Controller's Dominate Mind
#                     fails, and the player breaks the eggs by walking over or clicking them (instead of
#                     controlling Razorgore with the Orb of Domination, which still works).
#        Default:     1 - Enabled
#
#    Unbound.SoloRaid.RazorgoreWaveInterval
#        Description: Blackwing Lair, Razorgore solo: the fewest seconds between his add waves. The
#                     instance sends a wave of 2-5 adds every 15 seconds; a wave that comes sooner than
#                     this after the last one kept is removed. 15 (or less) = unchanged. Needs
#                     Unbound.SoloRaid.Razorgore.
#        Default:     30
#
#    Unbound.SoloRaid.Vaelastrasz
#        Description: Blackwing Lair, Vaelastrasz the Corrupt: Burning Adrenaline (kills its target
#                     when it ends) fails.
#        Default:     1 - Enabled
#
#    Unbound.SoloRaid.Ebonroc
#        Description: Blackwing Lair, Ebonroc: Shadow of Ebonroc (heals him from every hit on the
#                     debuffed tank) fails.
#        Default:     1 - Enabled
#
#    Unbound.SoloRaid.Chromaggus
#        Description: Blackwing Lair, Chromaggus: Time Lapse (he ignores targets that have it) and
#                     Chromatic Mutation (all five Brood Afflictions) fail.
#        Default:     1 - Enabled
#
#    Unbound.SoloRaid.Nefarian
#        Description: Blackwing Lair, Nefarian: Lord Victor Nefarius' Shadow Command (mind control)
#                     fails.
#        Default:     1 - Enabled
#
#    Unbound.SoloRaid.Lucifron
#        Description: Molten Core, Lucifron: his Flamewaker Protectors' Dominate Mind fails.
#        Default:     1 - Enabled
#
#    Unbound.SoloRaid.Jindo
#        Description: Zul'Gurub, Jin'do the Hexxer: Brain Wash Totem (mind controls a player) and Banish
#                     (teleports the player into the pit) fail.
#        Default:     1 - Enabled
#
#    Unbound.SoloRaid.Hakkar
#        Description: Zul'Gurub, Hakkar: Cause Insanity (mind control) and Blood Siphon (heals him from
#                     every player without Poisonous Blood) fail.
#        Default:     1 - Enabled
#
#    Unbound.SoloRaid.Ayamiss
#        Description: Ruins of Ahn'Qiraj, Ayamiss the Hunter: Paralyze and the larva's Feed on the
#                     paralyzed player fail.
#        Default:     1 - Enabled
#
#    Unbound.SoloRaid.Skeram
#        Description: Temple of Ahn'Qiraj, The Prophet Skeram: True Fulfillment (mind control) fails.
#        Default:     1 - Enabled
#
#    Unbound.SoloRaid.TwinEmperors
#        Description: Temple of Ahn'Qiraj, Twin Emperors: Heal Brother (heals each emperor while they
#                     are close together) fails.
#        Default:     1 - Enabled
#
#    Unbound.SoloRaid.Viscidus
#        Description: Temple of Ahn'Qiraj, Viscidus: every hit counts Unbound.SoloRaid.ViscidusHitMultiplier
#                     times towards freezing (200 frost hits) and shattering him (150 hits within 15
#                     seconds of freezing).
#        Default:     1 - Enabled
#
#    Unbound.SoloRaid.ViscidusHitMultiplier
#        Description: How many times each hit counts on Viscidus solo (10: 20 frost hits freeze him,
#                     15 melee hits shatter him).
#        Default:     10
#
#    Unbound.SoloRaid.QirajiMindslayer
#        Description: Temple of Ahn'Qiraj, Qiraji Mindslayer: Cause Insanity (mind control) fails.
#        Default:     1 - Enabled
#
#    Unbound.SoloRaid.Thaddius
#        Description: Naxxramas (classic), Thaddius: Stalagg and Feugen don't revive each other (normally
#                     both must die within 5 seconds, on platforms far apart) and don't overload their
#                     Tesla Coils when they follow the player off their platforms.
#        Default:     1 - Enabled
#
#    Unbound.SoloRaid.Gothik
#        Description: Naxxramas (classic), Gothik the Harvester: his phase two teleport keeps the player on
#                     his threat list (normally it drops everyone on the other side; with one player he
#                     would reset). Solo the gate is open by then, so he follows the player through it.
#        Default:     1 - Enabled

Unbound.SoloRaid.Enable = 1
Unbound.SoloRaid.Razorgore = 1
Unbound.SoloRaid.RazorgoreWaveInterval = 30
Unbound.SoloRaid.Vaelastrasz = 1
Unbound.SoloRaid.Ebonroc = 1
Unbound.SoloRaid.Chromaggus = 1
Unbound.SoloRaid.Nefarian = 1
Unbound.SoloRaid.Lucifron = 1
Unbound.SoloRaid.Jindo = 1
Unbound.SoloRaid.Hakkar = 1
Unbound.SoloRaid.Ayamiss = 1
Unbound.SoloRaid.Skeram = 1
Unbound.SoloRaid.TwinEmperors = 1
Unbound.SoloRaid.Viscidus = 1
Unbound.SoloRaid.ViscidusHitMultiplier = 10
Unbound.SoloRaid.QirajiMindslayer = 1
Unbound.SoloRaid.Thaddius = 1
Unbound.SoloRaid.Gothik = 1

#    Unbound.Naxx40.Doable.FourHorsemen
#    Unbound.Naxx40.Doable.Gluth
#    Unbound.Naxx40.Doable.Patchwerk
#    Unbound.Naxx40.Doable.Razuvious
#        Description: Classic Naxxramas (src/naxx40): easier versions of four bosses, for everyone in the
#                     raid (not only solo). Four Horsemen: much lower ability damage and no Void Zones, so
#                     they can be fought together. Gluth: looks for a zombie to eat every 12 seconds
#                     instead of 3. Patchwerk: Hateful Strike does 80% of its damage. Razuvious: Disrupting
#                     Shout instead of Mana Burn.
#        Default:     0 - Classic
#                     1 - Easier
#
#    Unbound.Naxx40.BotAccountRegex
#        Description: Accounts whose name matches this (case-insensitive) are playerbots: the Naxxramas
#                     runestone takes them in with their group without the attunement quest. Empty = none.
#        Default:     "^RNDBOT.*"

Unbound.Naxx40.Doable.FourHorsemen = 0
Unbound.Naxx40.Doable.Gluth = 0
Unbound.Naxx40.Doable.Patchwerk = 0
Unbound.Naxx40.Doable.Razuvious = 0
Unbound.Naxx40.BotAccountRegex = "^RNDBOT.*"

#    Unbound.RaidFinder.Enable
#        Description: Raid Finder (src/unbound_raid_finder.cpp): the Raids tab in the Dungeon Finder (needs the
#                     UnboundRaidFinder addon). Solo players enter a raid straight away; in a group the
#                     leader enters first and everyone else gets a prompt to follow. "Leave Raid" sends a
#                     player back to where they joined from.
#        Default:     1 - Enabled
#                     0 - Disabled

Unbound.RaidFinder.Enable = 1
