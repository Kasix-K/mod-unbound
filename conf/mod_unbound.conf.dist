Unbound.Perks.PlantedFeet.Mana = "0.25, 0.4, 0.5, 0.65, 0.75"
Unbound.Perks.PlantedFeet.Delay = "3, 3, 3, 3, 3"
Unbound.Perks.PlantedFeet.RankLevels = "1, 30, 60, 255, 255"
